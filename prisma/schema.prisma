generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Subset schema for generate only. Tables already exist on the RedDirt database.
// Do NOT run `prisma migrate deploy` from this repo — a subset schema would look like drift.

enum ContactIntelMethodKind {
  EMAIL
  PHONE
}

enum ContactIntelImportJobStatus {
  UPLOADED
  PREVIEWED
  COMMITTED
  FAILED
}

enum ContactIntelSourceRowStatus {
  PENDING
  INVALID
  NEW
  UPDATE
  CONFLICT
  SKIPPED
  COMMITTED
}

enum ContactIntelConflictStatus {
  OPEN
  DISMISSED
}

enum ContactIntelCustomFieldType {
  TEXT
}

model ContactIntelPerson {
  id          String   @id @default(cuid())
  displayName String
  firstName   String?  @db.VarChar(200)
  lastName    String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  methods        ContactIntelMethod[]
  sourceRows     ContactIntelSourceRow[]
  conflictsLeft  ContactIntelConflict[]  @relation("ContactIntelConflictLeft")
  conflictsRight ContactIntelConflict[]  @relation("ContactIntelConflictRight")
  addresses      ContactIntelAddress[]
  personTags     ContactIntelPersonTag[]
  customValues   ContactIntelCustomFieldValue[]

  @@index([displayName])
  @@index([updatedAt])
}

model ContactIntelMethod {
  id              String                 @id @default(cuid())
  personId        String
  person          ContactIntelPerson     @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind            ContactIntelMethodKind
  originalValue   String                 @db.Text
  normalizedValue String                 @db.VarChar(320)
  createdAt       DateTime               @default(now())

  @@unique([kind, normalizedValue])
  @@index([personId])
  @@index([normalizedValue])
}

model ContactIntelImportJob {
  id               String                      @id @default(cuid())
  originalFilename String                      @db.VarChar(500)
  fileHash         String                      @db.VarChar(64)
  sourceLabel      String?                     @db.VarChar(320)
  status           ContactIntelImportJobStatus @default(UPLOADED)
  mappingJson      Json                        @default("{}")
  headerJson       Json                        @default("[]")
  statsJson        Json                        @default("{}")
  previewJson      Json                        @default("{}")
  errorSummary     String?                     @db.Text
  createdByUserId  String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  committedAt      DateTime?

  rows      ContactIntelSourceRow[]
  conflicts ContactIntelConflict[]

  @@index([fileHash])
  @@index([status, createdAt])
  @@index([createdByUserId])
}

model ContactIntelSourceRow {
  id           String                      @id @default(cuid())
  jobId        String
  job          ContactIntelImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber    Int
  rawJson      Json                        @default("{}")
  rowHash      String                      @db.VarChar(64)
  status       ContactIntelSourceRowStatus @default(PENDING)
  displayName  String?
  firstName    String?                     @db.VarChar(200)
  lastName     String?                     @db.VarChar(200)
  emailsJson   Json                        @default("[]")
  phonesJson   Json                        @default("[]")
  personId     String?
  person       ContactIntelPerson?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  messagesJson   Json                        @default("[]")
  enrichmentJson Json                        @default("{}")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  conflicts    ContactIntelConflict[]
  addresses    ContactIntelAddress[]
  personTags   ContactIntelPersonTag[]
  customValues ContactIntelCustomFieldValue[]

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
  @@index([rowHash])
  @@index([personId])
}

model ContactIntelConflict {
  id            String                     @id @default(cuid())
  jobId         String
  job           ContactIntelImportJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceRowId   String
  sourceRow     ContactIntelSourceRow      @relation(fields: [sourceRowId], references: [id], onDelete: Cascade)
  leftPersonId  String
  leftPerson    ContactIntelPerson         @relation("ContactIntelConflictLeft", fields: [leftPersonId], references: [id], onDelete: Cascade)
  rightPersonId String
  rightPerson   ContactIntelPerson         @relation("ContactIntelConflictRight", fields: [rightPersonId], references: [id], onDelete: Cascade)
  reason        String                     @db.Text
  status        ContactIntelConflictStatus @default(OPEN)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([jobId, status])
  @@index([sourceRowId])
}

model ContactIntelAddress {
  id           String                 @id @default(cuid())
  personId     String
  person       ContactIntelPerson     @relation(fields: [personId], references: [id], onDelete: Cascade)
  line         String?                @db.VarChar(500)
  city         String?                @db.VarChar(200)
  state        String?                @db.VarChar(80)
  postalCode   String?                @db.VarChar(20)
  originalJson Json                   @default("{}")
  fingerprint  String                 @db.VarChar(64)
  sourceRowId  String?
  sourceRow    ContactIntelSourceRow? @relation(fields: [sourceRowId], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([personId, fingerprint])
  @@index([personId])
  @@index([fingerprint])
  @@index([sourceRowId])
}

model ContactIntelTag {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(200)
  key       String   @unique @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people ContactIntelPersonTag[]
}

model ContactIntelPersonTag {
  id          String                 @id @default(cuid())
  personId    String
  person      ContactIntelPerson     @relation(fields: [personId], references: [id], onDelete: Cascade)
  tagId       String
  tag         ContactIntelTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  sourceRowId String?
  sourceRow   ContactIntelSourceRow? @relation(fields: [sourceRowId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@unique([personId, tagId])
  @@index([tagId])
  @@index([sourceRowId])
}

model ContactIntelCustomFieldDefinition {
  id        String                      @id @default(cuid())
  key       String                      @unique @db.VarChar(80)
  label     String                      @db.VarChar(200)
  type      ContactIntelCustomFieldType @default(TEXT)
  active    Boolean                     @default(true)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  values ContactIntelCustomFieldValue[]
}

model ContactIntelCustomFieldValue {
  id              String                            @id @default(cuid())
  personId        String
  person          ContactIntelPerson                @relation(fields: [personId], references: [id], onDelete: Cascade)
  definitionId    String
  definition      ContactIntelCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  originalValue   String                            @db.Text
  normalizedValue String                            @db.VarChar(500)
  sourceRowId     String?
  sourceRow       ContactIntelSourceRow?            @relation(fields: [sourceRowId], references: [id], onDelete: SetNull)
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([personId, definitionId])
  @@index([definitionId])
  @@index([normalizedValue])
  @@index([sourceRowId])
}
