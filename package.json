{
  "name": "contact-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-h-drive-env.cjs next dev -p 3005",
    "local": "node scripts/run-local.cjs",
    "postinstall": "node scripts/prisma-generate.cjs",
    "build": "node scripts/prisma-generate.cjs && node scripts/run-with-h-drive-env.cjs next build",
    "start": "node scripts/run-with-h-drive-env.cjs next start -p 3005",
    "typecheck": "node scripts/run-with-h-drive-env.cjs tsc --noEmit",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "normalize-check": "node scripts/run-with-h-drive-env.cjs node ./node_modules/tsx/dist/cli.mjs scripts/verify-normalize.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
