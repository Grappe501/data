# Copy values from RedDirt (.env / .env.local). Never commit real secrets.
# Local runs can also load RedDirt env automatically via scripts/run-with-h-drive-env.cjs.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Optional. Localhost in development skips the passphrase.
# ADMIN_SECRET=
# ADMIN_REQUIRE_AUTH_ON_LOCALHOST=1
